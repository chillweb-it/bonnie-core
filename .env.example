# Existing Slack service
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Claude is the unattended AI worker used by Railway
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_AGENT_MODEL=claude-sonnet-5-5

# Notion registry / durable records
NOTION_TOKEN=
NOTION_TASKS_DATA_SOURCE_ID=d8077d5a-5ae0-43e5-bd11-b67fc398a090
NOTION_AGENTS_DATA_SOURCE_ID=a4bd3853-3941-47fe-856e-fd9e9f4fef1b
NOTION_AGENT_RUNS_DATA_SOURCE_ID=a65473ac-a52c-407b-9117-270e3519908a
NOTION_VERSION=2026-03-11
NOTION_TIMEOUT_SECONDS=30

# v0.5 conversation-first routing
# ChatGPT Bonnie creates CLAUDE Agent Runs; Railway consumes them.
ENABLE_AGENT_RUN_QUEUE=true
AGENT_RUN_POLL_SECONDS=10

# Legacy v0.4 behavior: Notion Tasks as an AI execution queue.
# Keep false for the new conversation-first architecture.
ENABLE_NOTION_TASK_WORKER=false
NOTION_POLL_SECONDS=30

# Reliability controls
AGENT_MAX_ATTEMPTS=3
AGENT_TIMEOUT_SECONDS=90
AGENT_RETRY_DELAY_SECONDS=2
AGENT_MAX_TOKENS=2000


# Shared Knowledge v0.6 (disabled until infrastructure is configured)
ENABLE_KNOWLEDGE=false
KNOWLEDGE_DATABASE_URL=
NOTION_KNOWLEDGE_DATA_SOURCE_ID=
KNOWLEDGE_SYNC_SECONDS=120
KNOWLEDGE_MAX_STALE_SECONDS=900
KNOWLEDGE_SLACK_SCOPES={}
KNOWLEDGE_API_KEYS={}
